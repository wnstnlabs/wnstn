{
  "name": "@wnstn/canopy",
  "version": "0.1.0",
  "description": "Canopy — safest, smallest, privacy-first analytics (< 2kb). Cookieless by default, DNT aware, no fingerprinting.",
  "type": "module",
  "main": "./dist/canopy.cjs.js",
  "module": "./dist/canopy.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/canopy.es.js",
      "require": "./dist/canopy.cjs.js"
    },
    "./script": {
      "import": "./dist/script.js",
      "types": "./dist/script.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "analytics",
    "privacy",
    "cookieless",
    "tracking",
    "lightweight",
    "nextjs"
  ],
  "author": "wnstn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/winston/wnstn",
    "directory": "packages/canopy"
  },
  "dependencies": {
    "effect": "^3.21.4"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@vitest/browser": "^1.0.0",
    "jsdom": "^30.1.0",
    "next": "^16.3.4",
    "react": "^19.2.7",
    "typescript": "^5.9.2",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
