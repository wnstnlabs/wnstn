# Canopy — env
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/canopy
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3002
NEXT_PUBLIC_CANOPY_URL=http://localhost:3002

# Optional — enable "Continue with Winston" (OIDC)
# Winston must have the oidcProvider plugin enabled and expose:
#   WINSTON_OIDC_ISSUER=https://winston.your.app
#   WINSTON_OIDC_CLIENT_ID=...
#   WINSTON_OIDC_CLIENT_SECRET=...
WINSTON_OIDC_ISSUER=
WINSTON_OIDC_CLIENT_ID=
WINSTON_OIDC_CLIENT_SECRET=

# Optional — expose script at custom domain
NEXT_PUBLIC_SCRIPT_URL=https://canopy.your.app/p.js
